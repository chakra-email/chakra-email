{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "types": ["vitest/globals", "node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.test.ts",
