{
  "name": "@chakra-email/preview",
  "version": "0.3.0",
  "description": "Preview and inspect React emails locally with live props, template variants, HTML and plain-text views, and email lint checks.",
  "license": "MIT",
  "author": {
    "name": "Ryan Hefner",
    "email": "hi@ryanhefner.com",
    "url": "https://www.ryanhefner.com"
  },
  "contributors": [
    {
      "name": "Commune Software",
      "url": "https://commune.software"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ryanhefner"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chakra-email/chakra-email.git",
    "directory": "packages/preview"
  },
  "bugs": {
    "url": "https://github.com/chakra-email/chakra-email/issues"
  },
  "homepage": "https://chakra.email/docs/preview",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "chakra-email-preview": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!**/*.tsbuildinfo"
  ],
  "keywords": [
    "chakra-email",
    "email-development",
    "email-preview",
    "email-templates",
    "email-testing",
    "html-email",
    "react",
    "react-email",
    "typescript"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "nx": {
    "implicitDependencies": [
      "preview-ui"
    ],
    "tags": [
      "scope:chakra-email-preview"
    ]
  },
  "dependencies": {
    "@chakra-email/core": "^0.3.0",
    "jiti": "^2.4.2",
    "launch-editor": "^2.14.2",
    "parse5": "^8.0.0",
    "tinyglobby": "^0.2.17",
    "tslib": "^2.3.0",
    "vite": "~8.1.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
