{
  "name": "@chakra-email/chakra-v2",
  "version": "0.1.0",
  "description": "React email components and theme adapter for Chakra UI v2.",
  "license": "MIT",
  "author": {
    "name": "Ryan Hefner",
    "email": "hi@ryanhefner.com",
    "url": "https://www.ryanhefner.com"
  },
  "contributors": [
    {
      "name": "Commune Software",
      "url": "https://commune.software"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ryanhefner"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chakra-email/chakra-email.git",
    "directory": "packages/chakra-email-v2"
  },
  "bugs": {
    "url": "https://github.com/chakra-email/chakra-email/issues"
  },
  "homepage": "https://github.com/chakra-email/chakra-email/tree/main/packages/chakra-email-v2#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    },
    "./system": {
      "types": "./dist/system.d.ts",
      "import": "./dist/system.js",
      "default": "./dist/system.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!**/*.tsbuildinfo"
  ],
  "keywords": [
    "chakra",
    "chakra-ui",
    "chakra-v2",
    "chakra-theme",
    "email",
    "email-components",
    "email-renderer",
    "email-templates",
    "html-email",
    "jsx-email",
    "markdown-email",
    "react",
    "react-email",
    "server-rendered",
    "typescript",
    "transactional-email"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@chakra-email/core": "^0.1.0",
    "tslib": "^2.3.0"
  },
  "nx": {
    "tags": [
      "scope:chakra-email-v2"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
